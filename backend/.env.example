# Clerk authentication (backend secret)
# Get this from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxx

# Server configuration
PORT=3000
FRONTEND_URL=http://localhost

# DATABASE_URL — Se genera automáticamente en docker-compose.yml
#
# DESARROLLO LOCAL (Docker Compose):
#   PostgreSQL 16 Alpine en docker-compose.yml
#   DATABASE_URL se configura en el servicio 'db'
#   Usuario: garnacheros
#   Password: [en .env.local]
#
# PRODUCCIÓN (VPS):
#   Neon PostgreSQL Serverless
#   DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/garnacheros?sslmode=require
#   Configurar en /root/.env del VPS via SSH
